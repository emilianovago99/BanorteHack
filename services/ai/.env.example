GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# gemini exige IA real; auto permite respaldo local; local evita llamadas externas.
# Los errores de cuota se comunican mediante MCP, sin inventar respuestas.
AI_MODE=auto
DATABASE_URL=postgresql://lazy-bank:local-development-only@localhost:5432/lazy-bank
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=lazy-bank
