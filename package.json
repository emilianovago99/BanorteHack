{
  "name": "banortehack",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "services/api"],
  "engines": { "node": ">=20.19.4" },
  "scripts": {
    "dev:web": "npm run dev --workspace @banortehack/web",
    "dev:mobile": "npm run start --workspace @banortehack/mobile",
    "dev:api": "npm run dev --workspace @banortehack/api",
    "build": "npm run build --workspace @banortehack/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @banortehack/api"
  },
  "devDependencies": { "typescript": "~5.9.2" }
}
