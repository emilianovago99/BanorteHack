  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "__schema1": {
      "oneOf": [
        {
          "$ref": "#/$defs/__schema2"
        },
        {
          "$ref": "#/$defs/__schema7"
        }
      ]
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/__schema3"
        },
        "kind": {
          "type": "string",
          "const": "mutation"
        },
        "event": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "label",
        "kind",
        "event"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "confirm_debt_payment"
        },
        "context": {
          "type": "object",
          "properties": {
            "debt_id": {
              "$ref": "#/$defs/__schema5"
            },
            "extra_payment": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "multipleOf": 0.01,
              "$ref": "#/$defs/__schema6"
            }
          },
          "required": [
            "debt_id",
            "extra_payment"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "context"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "card-classic",
        "personal-loan",
        "laptop"
      ]
    },
    "__schema6": {
      "type": "number"
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/__schema3"
        },
        "kind": {
          "type": "string",
          "const": "simulation"
        },
        "event": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": [
        "label",
        "kind",
        "event"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "select_plan"
        },
        "context": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "name",
        "context"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "plan_id": {
          "type": "string",
          "enum": [
            "conservative",
            "balanced",
            "growth"
          ]
        },
        "amount": {
          "default": 10000,
          "type": "number",
          "minimum": 100,
          "maximum": 1000000,
          "$ref": "#/$defs/__schema6"
        },
        "monthly_contribution": {
          "default": 1000,
          "type": "number",
          "minimum": 0,
          "maximum": 100000,
          "$ref": "#/$defs/__schema6"
        },
        "months": {
          "default": 24,
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      },
      "required": [
        "plan_id"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "string"
    },
    "__schema11": {
      "type": "string"
    },
    "__schema12": {
      "type": "string",
      "maxLength": 4000
    },
    "__schema13": {
      "type": "string"
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "format": "starts_with",
          "pattern": "^\\/.*"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "__schema16": {
      "$ref": "#/$defs/__schema17"
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "event": {
          "oneOf": [
            {
              "$ref": "#/$defs/__schema8"
            },
            {
              "$ref": "#/$defs/__schema4"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "const": "simulate_investment"
                },
                "context": {
                  "$ref": "#/$defs/__schema9"
                }
              },
              "required": [
                "name",
                "context"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "const": "simulate_debt"
                },
                "context": {
                  "type": "object",
                  "properties": {
                    "debt_id": {
                      "$ref": "#/$defs/__schema5"
                    },
                    "extra_payment": {
                      "default": 500,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100000,
                      "$ref": "#/$defs/__schema6"
                    }
                  },
                  "required": [
                    "debt_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "context"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "const": "compare_plans"
                },
                "context": {
                  "type": "object",
                  "properties": {
                    "amount": {
                      "default": 10000,
                      "type": "number",
                      "minimum": 100,
                      "maximum": 1000000,
                      "$ref": "#/$defs/__schema6"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "context"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "const": "show_transactions"
                },
                "context": {
                  "type": "object",
                  "properties": {
                    "month": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^20\\d{2}-(0[1-9]|1[0-2])$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "kind": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "income",
                            "expense"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "context"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "event"
      ],
      "additionalProperties": false
    }
  },
  "$id": "lazy-bank:finance-v1"
